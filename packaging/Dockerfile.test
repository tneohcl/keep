FROM debian:trixie-slim
ENV PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive QT_QPA_PLATFORM=offscreen
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pyside6.qtcore python3-pyside6.qtgui python3-pyside6.qtwidgets qt6-svg-plugins borgbackup fuse python3-llfuse && rm -rf /var/lib/apt/lists/*
WORKDIR /keep
COPY . /keep
CMD ["bash", "packaging/test-linux.sh"]
